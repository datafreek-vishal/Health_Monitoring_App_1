# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://healthguard_user:healthguard_password@localhost:5432/healthguard_db"

# Redis Cache & Emergency Temporary State
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="replace-with-a-secure-256-bit-secret-in-production"
JWT_REFRESH_SECRET="replace-with-a-secure-256-bit-refresh-secret"

# Event Streaming / Message Broker (Kafka)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# Emergency Dispatch & Notification Providers (Twilio/AWS SNS/Exotel for India)
SMS_GATEWAY_PROVIDER="mock_or_exotel"
SMS_GATEWAY_API_KEY=""
VOICE_GATEWAY_API_KEY=""
PUSH_NOTIFICATION_KEY=""

# Geolocation & Maps (Google Maps / Mapbox / OpenStreetMap)
MAPS_API_KEY=""

